#!/bin/kuroko
'''
List files open by processes.
'''

import kuroko
import fileio
import os
import stat
from collections import defaultdict

def safe_readlines(path):
    try:
        with fileio.open(path,'r') as f:
            return f.readlines()
    except:
        return []

def safe_listdir(path):
    try:
        with fileio.opendir(path) as d:
            return [e['name'] for e in d], None
    except Exception as e:
        return [], e

def safe_readlink(path):
    try:
        return os.readlink(path)
    except Exception as e:
        return f'{path} (readlink: {e})'

def getpwnam(uid):
    '''Because we don't have a 'pwd' module...'''
    for line in safe_readlines('/etc/passwd'):
        let ents = line.strip().split(':')
        if len(ents) > 2 and ents[2] == str(uid):
            return ents[0]
    return str(uid)

def __main__(args):
    let columns = ['COMMAND', 'PID', 'USER', 'FD ', 'TYPE', 'OFFSET', 'NODE', 'NAME']
    let aligns  = ['<',       '>',   '>',    '>',   '>',    '>',      '>',    '<']
    let files = []
    let pids = []
    let max_width = None

    try:
        if os.isatty(1):
            let a, b = os.get_terminal_size(1)
            max_width = a

    # Collect processes
    let pid_dirs, exc = safe_listdir('/proc')
    for d in pid_dirs:
        if d.isdigit():
            pids.append(int(d))

    # Collect files
    for pid in pids:
        # Get the name of this process
        let skip = False
        let name = ''
        let userid = -1
        for line in safe_readlines(f'/proc/{pid}/status'):
            let parts = line.strip().split('\t')
            if len(parts) < 2: continue
            if parts[0] == 'Tgid:' and str(pid) != parts[1]:
                skip = True
                break
            if parts[0] == 'Name:':
                name = parts[1]
            if parts[0] == 'Uid:':
                userid = int(parts[1])

        if skip:
            continue # thread

        # Get user name from uid
        let user = ''
        if userid != -1:
            user = getpwnam(userid)

        # Shortcut for common parts
        def add_file(fd, path, mode=' ', off=''):
            let type = ''
            let node = ''
            try:
                let s = os.stat(path)
                if   stat.S_ISBLK (s.st_mode): type = 'BLK'
                elif stat.S_ISCHR (s.st_mode): type = 'CHR'
                elif stat.S_ISDIR (s.st_mode): type = 'DIR'
                elif stat.S_ISFIFO(s.st_mode): type = 'FIFO'
                elif stat.S_ISSOCK(s.st_mode): type = 'SOCK'
                elif stat.S_ISLNK (s.st_mode): type = 'LNK' # ?
                elif stat.S_ISREG (s.st_mode): type = 'REG'
                node = s.st_ino
            except:
                if path.startswith('socket'):  type = 'SOCK'
                elif path.startswith('pipe:'): type = 'FIFO'
                elif path.startswith('ptm:'):  type = 'tty'
            files.append((name, pid, user, f'{fd}{mode}', type, off, node, path))

        # cwd
        let cwd = safe_readlink(f'/proc/{pid}/cwd')
        if cwd: add_file('cwd', cwd)

        # File descriptors
        let fds, exc = safe_listdir(f'/proc/{pid}/fd')
        if exc and not fds:
            add_file('NOFD', f'/proc/{pid}/fd ({exc})')
        for fd in fds:
            if not fd.isdigit(): continue
            let path = safe_readlink(f'/proc/{pid}/fd/{fd}')
            let info = {}
            for line in safe_readlines(f'/proc/{pid}/fdinfo/{fd}'):
                if '\t' in line:
                let vals = line.strip().split('\t')
                info[vals[0]] = vals[1]
            let mode = ' '
            if 'flags:' in info:
                let b = int(info['flags:'], base=0)
                if (b & os.O_RDWR): mode = 'u'
                else if (b & os.O_WRONLY): mode = 'w'
                else: mode = 'r' # must be readonly
            let off = ''
            if 'pos:' in info:
                off = info['pos:']
            if path: add_file(fd, path, mode, off=off)

        # Mapped files
        let seen = set()
        let exe = safe_readlink(f'/proc/{pid}/exe')
        if exe:
            seen.add(exe)
            add_file('txt', exe)

        for line in safe_readlines(f'/proc/{pid}/maps'):
            let parts = line.strip().split()
            if len(parts) < 6: continue
            if not len(parts[5]): continue
            if parts[5].startswith('['): continue
            if parts[5] in seen: continue
            seen.add(parts[5])
            add_file('mem', parts[5])

    # Filter to arguments
    if args:
        args = set(args)
        let nfiles = []
        for file in files:
            if file[-1] not in args:
                continue
            nfiles.append(file)
        files = nfiles

    # Figure out column lengths
    let lengths = [len(x) for x in columns]
    for file in files:
        for i in range(len(columns)):
            lengths[i] = max(lengths[i], len(str(file[i])))

    # Header
    print(' '.join(columns[i].__format__(f'{aligns[i]}{lengths[i]}') for i in range(len(columns)))[:max_width])

    # Print 'em
    for file in files:
        print(' '.join(file[i].__format__(f'{aligns[i]}{lengths[i]}') for i in range(len(columns)))[:max_width])

    return 0

if __name__ == '__main__':
    return __main__(kuroko.argv[1:])
