#!/bin/kuroko
import kuroko
import os
import fileio
import time
import socket

time.sleep(1)

let sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)

def send_toast(msg):
    sock.sendto(msg.encode(), ('127.0.0.1',1030))

try:
    let user = os.environ.get('USER', 'local')
    let home = os.environ.get('HOME', f'/home/{user}')
    let path = f'{home}/.tutorial-shown'
    if not os.access(path, os.F_OK):
        let msg = '{"icon":"/usr/share/icons/48/help.png","body":"<b>Welcome to ToaruOS!</b><br>Run <b><mono>tutorial</mono></b> to view the<br>system walkthrough."}'
        send_toast(msg)
        os.open(path, os.O_WRONLY | os.O_CREAT, mode=0o644)

time.sleep(1)

try:
    let meminfo = {}

    let data
    with fileio.open('/proc/meminfo','r') as f:
        data = f.readlines()

    for line in data:
        if not ':' in line: continue
        let bits = line.strip().split(':',1)
        meminfo[bits[0].strip()] = bits[1].strip()

    if 'MemTotal' in meminfo:
        let kB = int(meminfo['MemTotal'].replace('kB',''))
        if kB < 1000000:
            let msg = '{"icon":"/usr/share/icons/48/help.png","body":"<b>Low System Memory</b><br>At least 1GiB of RAM is<br>recommended for the Live CD.<br>' + str(kB//1024) + 'MiB was detected."}'
            send_toast(msg)

try:
    let manifest
    with fileio.open('/var/msk/manifest','r') as f:
        manifest = f.readlines()

    let count = 0

    for line in manifest:
        if line.startswith('['):
            count++

    if count:
        let msg = '{"icon":"/usr/share/icons/48/package.png","body":"<b>Packages Available</b><br>' + str(count) + ' package' + ('s' if count > 1 else '') + ' are available from<br>the package repository."}'
        send_toast(msg)

return 0
